# Variáveis da API de Conversões da Meta (rota /api/capi).
# Copie pra .env.local (local) e pro painel da Vercel (produção).

# Opcional: o mesmo ID que está no index.html. Sem ele, a rota usa o do código.
FB_PIXEL_ID=

# Obrigatório. Gerado em Events Manager -> pilates pixel -> Configurações ->
# API de Conversões -> Gerar token de acesso. É SEGREDO: nunca com prefixo
# VITE_, senão vai parar no bundle do browser.
FB_CAPI_TOKEN=

# Opcional, só enquanto estiver validando na aba "Testar eventos".
FB_TEST_EVENT_CODE=
